#
# LLM bots environment template.
#
# Copy to conf/env.llm (gitignored), fill in your values, and point your
# worldserver process at it - for the AzerothCore docker stack, an `env_file:`
# entry in your compose override. Environment variables override values in
# mod_llm_bots.conf; the ones here are the ones you are most likely to change.
#
# NOTE: env vars are resolved by AzerothCore's IniKeyToEnvVarKey - dot, dash
# and camelCase boundaries become underscores, all uppercased, prefixed AC_.
#

# Master switch: 0 disables the whole module (all bots behave as plain
# playerbots). 1 enables it.
AC_LLM_BOTS_ENABLE=1

# "openai" (OpenAI Responses API), "foundry" (Microsoft Foundry / Azure OpenAI
# REST) or "mock" (canned responses, no network, for testing).
AC_LLM_BOTS_PROVIDER=openai

# Account that holds the roster characters. This account must NOT be one of
# the random-bot accounts - random-bot rotation is account-gated, and a roster
# bot on a non-random account is never logged out by RandomPlayerbotMgr.
AC_LLM_BOTS_BOT_ACCOUNT=llmbots

# OpenAI API key. SECRET - never commit this file.
AC_LLM_BOTS_OPENAI_API_KEY=

# Model names (the "model" field in the request body).
# Fast = small/cheap model for Tier 1 social calls.
# Think = larger model for Tier 2 planning.
AC_LLM_BOTS_OPENAI_MODEL_FAST=gpt-5.6-luna
AC_LLM_BOTS_OPENAI_MODEL_THINK=gpt-5.6-terra

# Budget. A 20-bot roster with a chronicler sits around 13 req/min and
# ~8k tokens/min; Azure ties RPM to TPM at 6 RPM per 1,000 TPM, so provision
# 10k TPM on the fast deployment and set these to match your quota.
AC_LLM_BOTS_MAX_CALLS_PER_MINUTE=20
AC_LLM_BOTS_MAX_TOKENS_PER_HOUR=600000
AC_LLM_BOTS_MAX_ROSTER_SIZE=20

# Cadence per bot.
AC_LLM_BOTS_SOCIAL_COOLDOWN_SEC=20
AC_LLM_BOTS_PLAN_INTERVAL_SEC=300

# Observer bot (optional). Must be an existing character, also listed in the
# roster as bot_type 1 (chronicler).
AC_LLM_BOTS_CHRONICLER_NAME=
